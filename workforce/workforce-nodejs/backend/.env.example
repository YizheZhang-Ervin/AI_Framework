# LLM 提供者: "local" (本地 node-llama-cpp) 或 "openai" (OpenAI 兼容 API)
LLM_PROVIDER=openai

# OpenAI 兼容 API 配置 (LLM_PROVIDER=openai 时生效)
OPENAI_API_KEY=xxx
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=GLM-4.7-Flash

# 本地模型配置 (LLM_PROVIDER=local 时生效)
LLM_MODEL_PATH=/xxx/Qwen3-0.6B-Q8_0.gguf

# 服务端口
PORT=3001